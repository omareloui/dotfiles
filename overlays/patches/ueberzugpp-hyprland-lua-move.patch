+                std::this_thread::sleep_for(std::chrono::milliseconds(delay_ms));
+                try {
+                    const UnixSocket socket{path};
+                    socket.write(payload.data(), payload.length());
+                    socket.read_until_empty();
+                } catch (...) {
+                    return;
